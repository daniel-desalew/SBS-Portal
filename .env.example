# Copy to .env for local development. Never commit real connection strings or secrets.
NODE_ENV=development

# Local app settings
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon PostgreSQL backend destination.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

REDIS_URL=redis://localhost:6379

# Generate strong, unique values before running the application.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
