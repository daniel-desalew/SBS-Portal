# Copy this file to .env for local development. Replace all placeholder secrets.
NODE_ENV=development

# Local app settings
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CLIENT_URL=http://localhost:3000

# Local Docker database credentials (change before deployment)
MONGO_ROOT_USERNAME=portal_dev
MONGO_ROOT_PASSWORD=change-this-local-password
MONGO_DATABASE=sbs_portal
MONGO_PORT=27018
MONGODB_URI=mongodb://portal_dev:change-this-local-password@localhost:27018/sbs_portal?authSource=admin
REDIS_URL=redis://localhost:6379

# Generate strong, unique values before running the application.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters